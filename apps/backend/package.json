{
  "name": "@ohana/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Ohana backend — Express + TypeScript + Sequelize + PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:clean": "ts-node src/scripts/seed-clean.ts",
    "seed:complete": "ts-node src/scripts/seed-complete.ts",
    "sync": "ts-node src/scripts/sync-models.ts",
    "reset": "npm run sync && npm run seed:complete",
    "create-tables": "ts-node src/scripts/create-missing-tables.ts",
    "migrate": "ts-node src/scripts/migrate.ts up",
    "migrate:down": "ts-node src/scripts/migrate.ts down",
    "migrate:legacy:up": "ts-node src/scripts/run-migration.ts up",
    "migrate:legacy:down": "ts-node src/scripts/run-migration.ts down",
    "check-users": "ts-node src/scripts/check-users.ts",
    "test:security": "ts-node src/scripts/test-security.ts",
    "download:models": "ts-node src/scripts/download-face-api-models.ts",
    "generate:key": "ts-node src/scripts/generate-encryption-key.ts",
    "validate:dependencies": "ts-node src/scripts/validate-dependencies.ts",
    "seed-pending": "ts-node src/scripts/seed-pending.ts",
    "seed-verifications": "ts-node src/scripts/seed-verifications.ts",
    "seed-navigation": "ts-node src/scripts/seed-navigation.ts",
    "seed:force-lease": "ts-node src/scripts/force-completed-rental.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "docker:prod:up": "docker-compose -f docker-compose.prod.yml --env-file .env.docker up --build -d",
    "docker:prod:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker-compose -f docker-compose.prod.yml logs -f backend",
    "docker:prod:restart": "docker-compose -f docker-compose.prod.yml restart backend",
    "docker:prod:clean": "docker-compose -f docker-compose.prod.yml down -v",
    "docker:prod:rebuild:fresh": "docker-compose -f docker-compose.prod.yml down && docker-compose -f docker-compose.prod.yml build --no-cache backend && docker-compose -f docker-compose.prod.yml up -d --renew-anon-volumes"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^2.1.0",
    "@types/sharp": "^0.31.1",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^2.4.3",
    "canvas": "^3.2.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.4",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "resend": "^6.17.2",
    "sequelize": "^6.37.8",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.41",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^6.0.2",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.0",
    "typescript": "^4.9.5"
  }
}
