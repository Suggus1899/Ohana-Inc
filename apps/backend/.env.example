# Server Configuration
PORT=3026
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration (local PostgreSQL — no Docker for dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ohana_db
DB_USER=postgres
DB_PASSWORD=1234

# Configuración de Navegación
OSRM_PORT=5001
NOMINATIM_PORT=8181
OSRM_API_URL=http://localhost:5001
NOMINATIM_API_URL=http://localhost:8181
USE_OSRM_MOCK=false

# KYC System Configuration

# Encryption (AES-256-GCM)
# Generate a 32-byte key in hex format (64 characters)
# Example: openssl rand -hex 32
ENCRYPTION_KEY=REDACTED

# Storage Configuration
STORAGE_TYPE=local
# Options: local | minio | s3

# Local Storage (when STORAGE_TYPE=local)
STORAGE_PATH=./storage/kyc

# MinIO/S3 Storage (when STORAGE_TYPE=minio or s3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=kyc-documents
STORAGE_REGION=us-east-1

# Email Configuration (SMTP - legacy)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@Ohana.com
PANEL_URL=https://Ohana.com/panel/verificacion

# Resend Configuration (transactional emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Ohana <soporte@Ohanaweb.me>
RESEND_WEBHOOK_SECRET=whk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CORS Configuration
# Comma-separated list of additional allowed origins
CORS_ORIGINS=https://ohana.app,https://www.ohana.app

# Face-API Models Path
FACE_API_MODELS_PATH=./models/face-api

# KYC Settings
KYC_MAX_ATTEMPTS=3
KYC_ATTEMPT_WINDOW_DAYS=30
KYC_VERIFICATION_EXPIRY_DAYS=365
KYC_MIN_FACE_MATCH_SCORE=80
KYC_MIN_LIVENESS_SCORE=85
KYC_MIN_DOCUMENT_VALIDITY_SCORE=70
KYC_MAX_FRAUD_SCORE=30

# Audit Logging Configuration (Requisito 32.11, 32.12)
AUDIT_STORAGE_TYPE=file
# Options: file | database
AUDIT_LOG_PATH=./logs
# Logs are retained for minimum 2 years (Requisito 32.11)

# Alert Configuration (Requisito 33.12, 33.13)
# Destinatarios de alertas en formato: email1:Nombre1,email2:Nombre2
# Ejemplo: admin@Ohana.com:Admin,ops@Ohana.com:Operations
ALERT_RECIPIENTS=admin@Ohana.com:Admin,operator@Ohana.com:Operator

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3026/api/auth/google/callback
FRONTEND_URL=http://localhost:8080
