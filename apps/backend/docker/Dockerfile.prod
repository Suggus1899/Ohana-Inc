FROM node:20-bookworm AS builder

WORKDIR /app

RUN apt-get update && \
    apt-get install -y python3 make g++ build-essential libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev ffmpeg libpixman-1-dev && \
    rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm run build

FROM node:20-bookworm

WORKDIR /app

RUN apt-get update && \
    apt-get install -y libcairo2 libpango1.0-0 libjpeg62-turbo libgif7 librsvg2-2 ffmpeg libpixman-1-0 netcat-openbsd && \
    rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm

COPY package.json pnpm-lock.yaml ./

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist

RUN mkdir -p /app/storage/kyc /app/logs /app/temp /app/uploads/payment-proofs /app/uploads/dispute-evidence

ENV NODE_ENV=production
ENV PORT=5000

EXPOSE 5000

COPY docker/entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "dist/index.js"]
