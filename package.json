{
  "name": "ohana",
  "version": "1.0.0",
  "private": true,
  "description": "Ohana — senior care homes (residencias) platform",
  "scripts": {
    "dev": "pnpm --parallel --filter @ohana/backend --filter @ohana/frontend run dev",
    "dev:backend": "pnpm --filter @ohana/backend dev",
    "dev:frontend": "pnpm --filter @ohana/frontend dev",
    "build": "pnpm -r run build",
    "build:backend": "pnpm --filter @ohana/backend build",
    "build:frontend": "pnpm --filter @ohana/frontend build",
    "test": "pnpm -r run test",
    "test:backend": "pnpm --filter @ohana/backend test",
    "test:frontend": "pnpm --filter @ohana/frontend test",
    "lint": "pnpm -r run lint"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
